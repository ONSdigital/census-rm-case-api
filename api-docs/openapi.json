      "CaseDetailsEventDTO" : {
        "required" : [ "eventChannel", "eventDate", "eventType", "id" ],
        "type" : "object",
        "properties" : {
          "eventChannel" : {
            "type" : "string",
            "description" : "Channel through which the event was triggered (RM, CC, etc.)",
            "example" : "RM"
          },
          "eventDate" : {
            "type" : "string",
            "description" : "Date and time when the event occurred",
            "format" : "date-time",
            "example" : "2024-01-15T10:30:00Z"
          },
          "eventDescription" : {
            "type" : "string",
            "description" : "Human-readable description of the event",
            "example" : "Case created for collection exercise"
          },
          "eventPayload" : {
            "type" : "string",
            "description" : "JSON payload containing event-specific data"
          },
          "eventSource" : {
            "type" : "string",
            "description" : "Source system that generated the event (e.g., UAC_SERVICE, PRINT_SERVICE)"
          },
          "eventTransactionId" : {
            "type" : "string",
            "description" : "Unique transaction identifier for this event",
            "format" : "uuid"
          },
          "eventType" : {
            "type" : "string",
            "description" : "Type of event (e.g., NEW_CASE, RECEIPT, REFUSAL, EQ_LAUNCH, UAC_AUTHENTICATION)",
