{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "RESTful API for managing census case data. Provides endpoints for querying and retrieving case information by various identifiers (UUID, reference, UPRN, postcode, QID). Returns comprehensive case details including address information, case status, and associated events.",
    "license" : {
      "name" : "Office for National Statistics",
      "url" : "https://www.ons.gov.uk"
    },
    "title" : "Case API Service",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost:8161",
    "description" : "Case API Service"
  } ],
  "tags" : [ {
    "description" : "Services for retrieving and managing questionnaire ID (QID) and UAC link information",
    "name" : "QID Endpoint"
  }, {
    "description" : "Services for querying and retrieving census cases",
    "name" : "Case Endpoint"
  } ],
  "paths" : {
    "/cases/case-details/{caseId}" : {
      "get" : {
        "description" : "Retrieves complete detailed case attributes for a given case UUID.",
        "operationId" : "getAllCaseDetailsByCaseId",
        "parameters" : [ {
          "description" : "Unique UUID of the case",
          "in" : "path",
          "name" : "caseId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseDetailsDTO"
                }
              }
            },
            "description" : "Detailed case record retrieved successfully"
          },
          "404" : {
            "description" : "Case ID not found"
          }
        },
        "summary" : "Get full case details by Case ID",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/postcode/{postcode}" : {
      "get" : {
        "description" : "Retrieves all cases located within the specified postcode area.",
        "operationId" : "getCasesByPostcode",
        "parameters" : [ {
          "description" : "Postal code identifier",
          "in" : "path",
          "name" : "postcode",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CaseContainerDTO"
                  }
                }
              }
            },
            "description" : "Matching cases retrieved successfully"
          }
        },
        "summary" : "Find cases by Postcode",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/qid/{qid}" : {
      "get" : {
        "description" : "Retrieves minimal case details linked to a specific questionnaire ID.",
        "operationId" : "findCaseByQid",
        "parameters" : [ {
          "description" : "Questionnaire Identifier",
          "in" : "path",
          "name" : "qid",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseContainerDTO"
                }
              }
            },
            "description" : "Case retrieved successfully"
          },
          "404" : {
            "description" : "QID not found"
          }
        },
        "summary" : "Find case by Questionnaire ID (QID)",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/ref/{reference}" : {
      "get" : {
        "description" : "Retrieves a single case container record using the numeric case reference.",
        "operationId" : "findCaseByReference",
        "parameters" : [ {
          "description" : "Unique numeric case reference identifier",
          "in" : "path",
          "name" : "reference",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "description" : "Flag indicating whether to include case events",
          "in" : "query",
          "name" : "caseEvents",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseContainerDTO"
                }
              }
            },
            "description" : "Case record found successfully"
          },
          "404" : {
            "description" : "Case reference not found"
          }
        },
        "summary" : "Find case by Reference",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/uprn/{uprn}" : {
      "get" : {
        "description" : "Retrieves all cases associated with a Unique Property Reference Number.",
        "operationId" : "findCasesByUPRN",
        "parameters" : [ {
          "description" : "Unique Property Reference Number",
          "in" : "path",
          "name" : "uprn",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Flag indicating whether to include case events",
          "in" : "query",
          "name" : "caseEvents",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        }, {
          "description" : "Filter results to valid addresses only",
          "in" : "query",
          "name" : "validAddressOnly",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CaseContainerDTO"
                  }
                }
              }
            },
            "description" : "Matching cases retrieved successfully"
          }
        },
        "summary" : "Find cases by UPRN",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/{id}" : {
      "get" : {
        "description" : "Retrieves a single case container record matching the specified UUID.",
        "operationId" : "findCaseById",
        "parameters" : [ {
          "description" : "Unique UUID of the case",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "Flag indicating whether to include case events",
          "in" : "query",
          "name" : "caseEvents",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseContainerDTO"
                }
              }
            },
            "description" : "Case record found successfully"
          },
          "404" : {
            "description" : "Case record not found"
          },
          "500" : {
            "description" : "Internal server error occurred"
          }
        },
        "summary" : "Find case by ID",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/qids/link" : {
      "put" : {
        "description" : "Links a questionnaire ID to a case. This endpoint is currently not implemented as the subscription for questionnaire links is not available.",
        "operationId" : "putQidLinkToCase",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewQidLink"
              }
            }
          },
          "description" : "QID link information to be created",
          "required" : true
        },
        "responses" : {
          "501" : {
            "description" : "Not Implemented - Questionnaire link subscription not available"
          }
        },
        "summary" : "Link QID to case",
        "tags" : [ "QID Endpoint" ]
      }
    },
    "/qids/{qid}" : {
      "get" : {
        "description" : "Retrieves the UAC-QID link information for a specified questionnaire ID, including associated case ID if available.",
        "operationId" : "getUacQidLinkByQid",
        "parameters" : [ {
          "description" : "Questionnaire Identifier (QID) to retrieve",
          "in" : "path",
          "name" : "qid",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QidLink"
                }
              }
            },
            "description" : "QID link details retrieved successfully"
          },
          "404" : {
            "description" : "Questionnaire ID not found"
          },
          "500" : {
            "description" : "Internal server error occurred"
          }
        },
        "summary" : "Retrieve QID link details",
        "tags" : [ "QID Endpoint" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CaseContainerDTO" : {
        "required" : [ "caseRef", "id" ],
        "type" : "object",
        "properties" : {
          "abpCode" : {
            "type" : "string",
            "description" : "Address Based Priority code"
          },
          "addressLevel" : {
            "type" : "string",
            "description" : "Address level classification"
          },
          "addressLine1" : {
            "type" : "string",
            "description" : "First line of street address"
          },
          "addressLine2" : {
            "type" : "string",
            "description" : "Second line of street address"
          },
          "addressLine3" : {
            "type" : "string",
            "description" : "Third line of street address"
          },
          "addressType" : {
            "type" : "string",
            "description" : "Type of address (e.g., HOUSEHOLD, COMMUNAL, OTHER)",
            "example" : "HOUSEHOLD"
          },
          "caseEvents" : {
            "type" : "array",
            "description" : "List of events associated with the case",
            "items" : {
              "$ref" : "#/components/schemas/CaseEventDTO"
            }
          },
          "caseRef" : {
            "type" : "string",
            "description" : "Unique numeric reference for the case",
            "example" : "100000000000001"
          },
          "caseType" : {
            "type" : "string",
            "description" : "Case type classification (e.g., NEW, REPLACEMENT)"
          },
          "collectionExerciseId" : {
            "type" : "string",
            "description" : "Collection Exercise UUID identifier",
            "format" : "uuid"
          },
          "createdDateTime" : {
            "type" : "string",
            "description" : "Date and time when the case was created",
            "format" : "date-time",
            "example" : "2024-01-15T10:30:00Z"
          },
          "estabType" : {
            "type" : "string",
            "description" : "Establishment type code"
          },
          "estabUprn" : {
            "type" : "string",
            "description" : "Establishment UPRN for non-household establishments"
          },
          "id" : {
            "type" : "string",
            "description" : "Unique case UUID identifier",
            "format" : "uuid",
            "example" : "a11e3456-e89b-12d3-a456-426614174000"
          },
          "invalid" : {
            "type" : "boolean",
            "description" : "Flag indicating if the case record is marked as invalid",
            "example" : false
          },
          "lad" : {
            "type" : "string",
            "description" : "Local Authority District code"
          },
          "lastUpdated" : {
            "type" : "string",
            "description" : "Date and time when the case was last updated",
            "format" : "date-time",
            "example" : "2024-01-20T14:45:00Z"
          },
          "latitude" : {
            "type" : "string",
            "description" : "Geographic latitude coordinate",
            "example" : "51.5074"
          },
          "longitude" : {
            "type" : "string",
            "description" : "Geographic longitude coordinate",
            "example" : "-0.1278"
          },
          "lsoa" : {
            "type" : "string",
            "description" : "Lower Layer Super Output Area code"
          },
          "msoa" : {
            "type" : "string",
            "description" : "Middle Layer Super Output Area code"
          },
          "oa" : {
            "type" : "string",
            "description" : "Output Area code"
          },
          "organisationName" : {
            "type" : "string",
            "description" : "Name of organization for establishment addresses"
          },
          "postcode" : {
            "type" : "string",
            "description" : "UK postal code",
            "example" : "AB12CD"
          },
          "region" : {
            "type" : "string",
            "description" : "Administrative region code"
          },
          "secureEstablishment" : {
            "type" : "boolean",
            "description" : "Indicator whether address is a secure establishment",
            "example" : false
          },
          "surveyType" : {
            "type" : "string",
            "description" : "Type of survey (e.g., CENSUS, OTHER_SURVEY)"
          },
          "townName" : {
            "type" : "string",
            "description" : "Town or city name"
          },
          "uprn" : {
            "type" : "string",
            "description" : "Unique Property Reference Number",
            "example" : "123456789"
          }
        },
        "description" : "Data Transfer Object representing a census case container",
        "example" : {
          "caseRef" : "100000000000001",
          "id" : "a11e3456-e89b-12d3-a456-426614174000",
          "uprn" : "123456789",
          "postcode" : "AB12CD",
          "addressType" : "HOUSEHOLD"
        }
      },
