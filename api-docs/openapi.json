{
  "openapi" : "3.0.1",
  "info" : {
    "description" : "Service for managing case data",
    "title" : "Case API Service",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "http://localhost:8161"
  } ],
  "tags" : [ {
    "description" : "Services for querying and retrieving census cases",
    "name" : "Case Endpoint"
  } ],
  "paths" : {
    "/cases/case-details/{caseId}" : {
      "get" : {
        "description" : "Retrieves complete detailed case attributes for a given case UUID.",
        "operationId" : "getAllCaseDetailsByCaseId",
        "parameters" : [ {
          "description" : "Unique UUID of the case",
          "in" : "path",
          "name" : "caseId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseDetailsDTO"
                }
              }
            },
            "description" : "Detailed case record retrieved successfully"
          },
          "404" : {
            "description" : "Case ID not found"
          }
        },
        "summary" : "Get full case details by Case ID",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/postcode/{postcode}" : {
      "get" : {
        "description" : "Retrieves all cases located within the specified postcode area.",
        "operationId" : "getCasesByPostcode",
        "parameters" : [ {
          "description" : "Postal code identifier",
          "in" : "path",
          "name" : "postcode",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CaseContainerDTO"
                  }
                }
              }
            },
            "description" : "Matching cases retrieved successfully"
          }
        },
        "summary" : "Find cases by Postcode",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/qid/{qid}" : {
      "get" : {
        "description" : "Retrieves minimal case details linked to a specific questionnaire ID.",
        "operationId" : "findCaseByQid",
        "parameters" : [ {
          "description" : "Questionnaire Identifier",
          "in" : "path",
          "name" : "qid",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseContainerDTO"
                }
              }
            },
            "description" : "Case retrieved successfully"
          },
          "404" : {
            "description" : "QID not found"
          }
        },
        "summary" : "Find case by Questionnaire ID (QID)",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/ref/{reference}" : {
      "get" : {
        "description" : "Retrieves a single case container record using the numeric case reference.",
        "operationId" : "findCaseByReference",
        "parameters" : [ {
          "description" : "Unique numeric case reference identifier",
          "in" : "path",
          "name" : "reference",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        }, {
          "description" : "Flag indicating whether to include case events",
          "in" : "query",
          "name" : "caseEvents",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseContainerDTO"
                }
              }
            },
            "description" : "Case record found successfully"
          },
          "404" : {
            "description" : "Case reference not found"
          }
        },
        "summary" : "Find case by Reference",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/uprn/{uprn}" : {
      "get" : {
        "description" : "Retrieves all cases associated with a Unique Property Reference Number.",
        "operationId" : "findCasesByUPRN",
        "parameters" : [ {
          "description" : "Unique Property Reference Number",
          "in" : "path",
          "name" : "uprn",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        }, {
          "description" : "Flag indicating whether to include case events",
          "in" : "query",
          "name" : "caseEvents",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        }, {
          "description" : "Filter results to valid addresses only",
          "in" : "query",
          "name" : "validAddressOnly",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CaseContainerDTO"
                  }
                }
              }
            },
            "description" : "Matching cases retrieved successfully"
          }
        },
        "summary" : "Find cases by UPRN",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/cases/{id}" : {
      "get" : {
        "description" : "Retrieves a single case container record matching the specified UUID.",
        "operationId" : "findCaseById",
        "parameters" : [ {
          "description" : "Unique UUID of the case",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "Flag indicating whether to include case events",
          "in" : "query",
          "name" : "caseEvents",
          "required" : false,
          "schema" : {
            "type" : "boolean",
            "default" : false
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CaseContainerDTO"
                }
              }
            },
            "description" : "Case record found successfully"
          },
          "404" : {
            "description" : "Case record not found"
          },
          "500" : {
            "description" : "Internal server error occurred"
          }
        },
        "summary" : "Find case by ID",
        "tags" : [ "Case Endpoint" ]
      }
    },
    "/qids/link" : {
      "put" : {
        "operationId" : "putQidLinkToCase",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewQidLink"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        },
        "tags" : [ "qid-endpoint" ]
      }
    },
    "/qids/{qid}" : {
      "get" : {
        "operationId" : "getUacQidLinkByQid",
        "parameters" : [ {
          "in" : "path",
          "name" : "qid",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/QidLink"
                }
              }
            },
            "description" : "OK"
          }
        },
        "tags" : [ "qid-endpoint" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "CaseContainerDTO" : {
        "required" : [ "caseRef", "id" ],
        "type" : "object",
        "properties" : {
          "abpCode" : {
            "type" : "string"
          },
          "addressLevel" : {
            "type" : "string"
          },
          "addressLine1" : {
            "type" : "string"
          },
          "addressLine2" : {
            "type" : "string"
          },
          "addressLine3" : {
            "type" : "string"
          },
          "addressType" : {
            "type" : "string"
          },
          "caseEvents" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CaseEventDTO"
            }
          },
          "caseRef" : {
            "type" : "string",
            "description" : "Unique numeric reference for the case",
            "example" : "100000000000001"
          },
          "caseType" : {
            "type" : "string"
          },
          "collectionExerciseId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "createdDateTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "estabType" : {
            "type" : "string"
          },
          "estabUprn" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "description" : "Unique case UUID identifier",
            "format" : "uuid",
            "example" : "a11e3456-e89b-12d3-a456-426614174000"
          },
          "invalid" : {
            "type" : "boolean"
          },
          "lad" : {
            "type" : "string"
          },
          "lastUpdated" : {
            "type" : "string",
            "format" : "date-time"
          },
          "latitude" : {
            "type" : "string"
          },
          "longitude" : {
            "type" : "string"
          },
          "lsoa" : {
            "type" : "string"
          },
          "msoa" : {
            "type" : "string"
          },
          "oa" : {
            "type" : "string"
          },
          "organisationName" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "region" : {
            "type" : "string"
          },
          "secureEstablishment" : {
            "type" : "boolean"
          },
          "surveyType" : {
            "type" : "string"
          },
          "townName" : {
            "type" : "string"
          },
          "uprn" : {
            "type" : "string"
          }
        },
        "description" : "Data Transfer Object representing a census case container"
      },
      "CaseDetailsDTO" : {
        "type" : "object",
        "properties" : {
          "abpCode" : {
            "type" : "string"
          },
          "addressLevel" : {
            "type" : "string"
          },
          "addressLine1" : {
            "type" : "string"
          },
          "addressLine2" : {
            "type" : "string"
          },
          "addressLine3" : {
            "type" : "string"
          },
          "addressType" : {
            "type" : "string"
          },
          "caseRef" : {
            "type" : "integer",
            "format" : "int64"
          },
          "caseType" : {
            "type" : "string"
          },
          "ceActualResponses" : {
            "type" : "integer",
            "format" : "int32"
          },
          "ceExpectedCapacity" : {
            "type" : "integer",
            "format" : "int32"
          },
          "collectionExerciseId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "createdDateTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "estabType" : {
            "type" : "string"
          },
          "estabUprn" : {
            "type" : "string"
          },
          "events" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/CaseDetailsEventDTO"
            }
          },
          "fieldCoordinatorId" : {
            "type" : "string"
          },
          "fieldOfficerId" : {
            "type" : "string"
          },
          "htcDigital" : {
            "type" : "string"
          },
          "htcWillingness" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "invalid" : {
            "type" : "boolean"
          },
          "lad" : {
            "type" : "string"
          },
          "lastUpdated" : {
            "type" : "string",
            "format" : "date-time"
          },
          "latitude" : {
            "type" : "string"
          },
          "longitude" : {
            "type" : "string"
          },
          "lsoa" : {
            "type" : "string"
          },
          "msoa" : {
            "type" : "string"
          },
          "oa" : {
            "type" : "string"
          },
          "organisationName" : {
            "type" : "string"
          },
          "postcode" : {
            "type" : "string"
          },
          "printBatch" : {
            "type" : "string"
          },
          "receiptReceived" : {
            "type" : "boolean"
          },
          "refusalReceived" : {
            "type" : "string",
            "enum" : [ "HARD_REFUSAL", "EXTRAORDINARY_REFUSAL", "SOFT_REFUSAL", "WITHDRAWAL_REFUSAL" ]
          },
          "region" : {
            "type" : "string"
          },
          "surveyLaunched" : {
            "type" : "boolean"
          },
          "townName" : {
            "type" : "string"
          },
          "treatmentCode" : {
            "type" : "string"
          },
          "uprn" : {
            "type" : "string"
          }
        }
      },
      "CaseDetailsEventDTO" : {
        "type" : "object",
        "properties" : {
          "eventChannel" : {
            "type" : "string"
          },
          "eventDate" : {
            "type" : "string",
            "format" : "date-time"
          },
          "eventDescription" : {
            "type" : "string"
          },
          "eventPayload" : {
            "type" : "string"
          },
          "eventSource" : {
            "type" : "string"
          },
          "eventTransactionId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "eventType" : {
            "type" : "string"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "messageTimestamp" : {
            "type" : "string",
            "format" : "date-time"
          },
          "rmEventProcessed" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "CaseEventDTO" : {
        "type" : "object",
        "properties" : {
          "createdDateTime" : {
            "type" : "string",
            "format" : "date-time"
          },
          "description" : {
            "type" : "string"
          },
          "eventType" : {
            "type" : "string",
            "enum" : [ "NEW_CASE", "RECEIPT", "REFUSAL", "INVALID_CASE", "EQ_LAUNCH", "UAC_AUTHENTICATION", "PRINT_FULFILMENT", "EXPORT_FILE", "DEACTIVATE_UAC", "UPDATE_SAMPLE", "UPDATE_SAMPLE_SENSITIVE", "SMS_FULFILMENT", "ACTION_RULE_SMS_REQUEST", "EMAIL_FULFILMENT", "ACTION_RULE_EMAIL_REQUEST", "ACTION_RULE_SMS_CONFIRMATION", "ACTION_RULE_EMAIL_CONFIRMATION", "ERASE_DATA" ]
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "NewQidLink" : {
        "type" : "object",
        "properties" : {
          "channel" : {
            "type" : "string"
          },
          "qidLink" : {
            "$ref" : "#/components/schemas/QidLink"
          },
          "transactionId" : {
            "type" : "string",
            "format" : "uuid"
          }
        }
      },
      "QidLink" : {
        "type" : "object",
        "properties" : {
          "caseId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "questionnaireId" : {
            "type" : "string"
          }
        }
      }
    }
  }
}
